# 从 xiaozhi.me 控制台复制。不要把真实地址发到群聊或提交到 Git。
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REPLACE_ME

# 两个容器都使用 host 网络，因此默认地址指向群晖本机的 Home Assistant。
HA_MCP_URL=http://127.0.0.1:8123/api/mcp

# Home Assistant：用户资料 -> 安全 -> 长期访问令牌。
HA_TOKEN=REPLACE_ME

# Optional: Windows laptop MCP agent URL on your Tailscale network.
# Example: PC_MCP_URL=http://100.x.y.z:8765/mcp
PC_MCP_URL=

# Optional: IoT backend API used by the reminder tools and MCP audit trail.
# Do not add credentials to this URL or commit the populated bridge.env file.
IOT_API_URL=http://127.0.0.1:8080
